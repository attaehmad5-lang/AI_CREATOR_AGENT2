# Copy to .env (git-ignored) and chmod 600. Values below are placeholders.
AI_CREATOR_PROFILE=dev
AI_CREATOR_LOG_LEVEL=DEBUG
AI_CREATOR_DATA_DIR=./var/data
AI_CREATOR_TMP_ROOT=./var/tmp
AI_CREATOR_MAX_RAM_MB=8192
AI_CREATOR_DEVICE_PREFERENCE=auto
AI_CREATOR_OPENAI_API_KEY=your_key_here
AI_CREATOR_ANTHROPIC_API_KEY=your_key_here
AI_CREATOR_GOOGLE_API_KEY=your_key_here
